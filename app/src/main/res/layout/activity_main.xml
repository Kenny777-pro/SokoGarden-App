<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Soko Garden"
        android:textSize="40sp"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:background="@drawable/shape"
        android:layout_marginBottom="10dp"/>

<!--    background shape implementation-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:backgroundTint="@color/black"
        android:background="@drawable/form_bg_shape">





<!--    logout button-->
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Log Out"
        android:backgroundTint="#DE0B1A"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:padding="14sp"
        android:layout_margin="20dp"
        android:id="@+id/logout"
        android:visibility="gone"/>
<!--        Signup Button-->

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sign Up"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:layout_marginTop="40dp"
        android:backgroundTint="@color/design_default_color_primary_variant"
        android:padding="14dp"
        android:layout_margin="20dp"
        android:id="@+id/signup"/>

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sign In"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:layout_marginTop="40dp"
        android:backgroundTint="@color/design_default_color_primary_variant"
        android:padding="14dp"
        android:layout_margin="20dp"
        android:id="@+id/signin"/>

</LinearLayout>


    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="About app"
        android:layout_margin="20dp"
        android:padding="14dp"
        android:backgroundTint="@color/design_default_color_on_secondary"
        android:textSize="18sp"
        android:id="@+id/about"/>


<!--    Display progressBar when loading products-->
    <ProgressBar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/progress"/>

<!--    Loading individual products using the recycler view-->
    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:listitem="@layout/single_item"
        android:id="@+id/recyclerview"/>


<!--    Developer status-->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="160dp"
        android:textColor="@color/design_default_color_primary_variant"
        android:textStyle="bold"
        android:textSize="15sp"
        android:text="Developed by Kenny"/>



</LinearLayout>