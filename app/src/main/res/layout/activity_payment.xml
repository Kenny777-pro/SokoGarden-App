<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cardview_dark_background"
    tools:context=".PaymentActivity">

<!--    Title textview-->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Make Payment"
        android:textSize="40sp"
        android:textColor="@color/white"
        android:background="@drawable/shape"
        android:textStyle="bold"
        android:textAlignment="center"
        android:padding="10dp"/>

    <!--    background shape implementation-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:backgroundTint="@color/black"
        android:padding="10dp"
        android:layout_margin="10dp"
        android:background="@drawable/form_bg_shape">


    <!--    product photo image view-->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:src="@drawable/ic_launcher_background"
        android:scaleType="centerCrop"
        android:layout_margin="5dp"
        android:id="@+id/product_photo"/>

<!--    product Name textview-->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Product Name"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="5dp"
        android:id="@+id/product_name"/>

<!--    Product cost textview-->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="KES100"
        android:textStyle="bold"
        android:textColor="#6B1EEF"
        android:id="@+id/product_cost"/>

<!--    Phone Number textview-->
    <androidx.appcompat.widget.AppCompatAutoCompleteTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Phone Number:"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:layout_marginLeft="10dp"/>

<!--    phone number edit text-->
    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter your phone number (+254)"
        android:background="@drawable/edittext_shape"
        android:padding="20dp"
        android:layout_margin="10dp"
        android:textColorHint="@color/black"
        android:textColor="@color/black"/>

<!--    purchase now button-->
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pay Now"
        android:backgroundTint="#5511D0"
        android:layout_margin="20dp"
        android:padding="20dp"
        android:id="@+id/pay"/>

    </LinearLayout>
</LinearLayout>